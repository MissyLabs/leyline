{
  "name": "magic-network",
  "version": "0.3.0",
  "description": "P2P discovery and messaging network for agentic bots",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run proto && tsc",
    "proto": "pbjs -t static-module -w es6 --es6 -o src/messages/compiled.js proto/message.proto && pbts -o src/messages/compiled.d.ts src/messages/compiled.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/cli.js",
    "start:seed": "node dist/cli.js --seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:single": "vitest run -t",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.0.0",
    "@chainsafe/libp2p-noise": "^16.0.0",
    "@chainsafe/libp2p-yamux": "^7.0.0",
    "@libp2p/bootstrap": "^11.0.0",
    "@libp2p/circuit-relay-v2": "^4.1.6",
    "@libp2p/crypto": "^5.0.0",
    "@libp2p/dcutr": "^3.0.13",
    "@libp2p/identify": "^3.0.0",
    "@libp2p/mdns": "^12.0.16",
    "@libp2p/peer-id": "^5.0.0",
    "@libp2p/tcp": "^10.0.0",
    "@libp2p/websockets": "^10.1.6",
    "@noble/ed25519": "^2.1.0",
    "it-length-prefixed": "^10.0.1",
    "it-pipe": "^3.0.1",
    "level": "^9.0.0",
    "libp2p": "^2.0.0",
    "protobufjs": "^7.4.0",
    "uint8arrays": "^5.1.0"
  },
  "overrides": {
    "@multiformats/multiaddr": "12.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "protobufjs-cli": "^1.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
